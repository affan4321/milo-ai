# Copy to .env.production on the server. NEVER commit the real file.
DOMAIN=milo.example.com
APP_URL=https://milo.example.com
POSTGRES_PASSWORD=generate-a-long-random-value      # openssl rand -hex 24
AUTH_SECRET=generate-a-long-random-value            # openssl rand -base64 32
BOT_TOKEN=generate-a-long-random-value              # shared secret between web and the bot
BOT_VNC_PASSWORD=choose-a-password

# Real providers
LLM_PROVIDER=gemini
STT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash
GEMINI_STT_MODEL=gemini-3.5-flash
GEMINI_STT_FALLBACK_MODELS=gemini-3.1-flash-lite
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email: "outbox" only writes files; use resend for real delivery.
EMAIL_PROVIDER=outbox
# RESEND_API_KEY=
# EMAIL_FROM=Milo <milo@your-domain>

# Optional backups when Gemini's daily allowance runs out
# GROQ_API_KEY=
# LLM_FALLBACK_PROVIDER=groq
# STT_FALLBACK_PROVIDER=whisper

# Optional Microsoft sign-in
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=common
