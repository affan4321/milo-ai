DATABASE_URL=postgres://milo:milo@localhost:5433/milo
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=milo
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
# Use "fake" to run without any external keys
STORAGE_PROVIDER=local
STT_PROVIDER=fake
LLM_PROVIDER=fake
EMAIL_PROVIDER=outbox
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=change-me

# Free tier is capped at ~20 requests/day PER MODEL, so transcripts and summaries use different models and each falls back on quota.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash
GEMINI_STT_MODEL=gemini-3.5-flash
GEMINI_STT_FALLBACK_MODELS=gemini-3.1-flash-lite

# Shared secret between the web app and the meeting bot
BOT_TOKEN=change-me-long-random
BOT_PROFILE_DIR=./.data/bot-profile
BOT_VNC_PASSWORD=choose-a-password

# Public address of the web app (used in recap and alert emails)
APP_URL=http://localhost:3000

# Microsoft sign-in + Outlook calendar (optional). Register an app in Azure (Entra ID); redirect URI: <APP_URL>/api/auth/callback/microsoft-entra-id.
# Add the optional ID-token claim "xms_edov" so work accounts can be trusted (see docs).
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common

# Groq (fast open-model hosting): optional fallback for summaries/Ask and speech-to-text. Free tier has small per-minute token limits.
GROQ_API_KEY=

# Optional backups, used ONLY when Gemini's daily allowance runs out (need GROQ_API_KEY).
# LLM_FALLBACK_PROVIDER=groq      # summaries/Ask on qwen3.8-27b; limited to ~4500-token inputs (free tier 8k tokens/min)
# STT_FALLBACK_PROVIDER=whisper   # Whisper large-v3; accurate + word timestamps, but no speaker separation
# EMBED_PROVIDER=local            # default; Groq has no embedding models

# --- Hosted web app on Vercel: variables to set there (kept in the untracked .env.vercel.local; see docs/VERCEL.md) ---
# APP_URL=https://miloainotetaker.vercel.app  AUTH_SECRET  BOT_TOKEN  GOOGLE_CLIENT_ID/SECRET  GEMINI_*  LLM_PROVIDER=gemini  STT_PROVIDER=gemini
# DATABASE_URL=<Neon pooled>  DATABASE_URL_DIRECT=<Neon direct, for the job queue>  DB_POOL_MAX=1  DB_PREPARE=false
# STORAGE_PROVIDER=s3  S3_ENDPOINT  S3_REGION=auto  S3_BUCKET  S3_ACCESS_KEY  S3_SECRET_KEY      (Cloudflare R2 or any S3-compatible bucket)
# EMBED_PROVIDER=remote  EMBED_URL=<tunnel to the worker's port 8788>  EMBED_TOKEN=<same value the worker has>
# Worker machine: set EMBED_TOKEN (turns on the embedding service, EMBED_PORT default 8788) and point DATABASE_URL/S3_* at the same Neon/R2.

# --- Single-VM Docker deployment (docker-compose.prod.yml reads this same file; see docs/DEPLOY.md) ---
# DOMAIN=milo.example.com  POSTGRES_PASSWORD=<random>  (plus BOT_TOKEN, BOT_VNC_PASSWORD, AUTH_SECRET, APP_URL above)

# --- Always-on machine (docker-compose.vm.yml; see docs/DEPLOY.md) ---
# NGROK_AUTHTOKEN=   NGROK_DOMAIN=<your-domain>.ngrok-free.app   (the tunnel that lets the Vercel site reach the worker's embedding service)
