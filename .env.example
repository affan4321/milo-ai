DATABASE_URL=postgres://milo:milo@localhost:5433/milo
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=milo
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
# Use "fake" to run without any external keys
STORAGE_PROVIDER=local
STT_PROVIDER=fake
LLM_PROVIDER=fake
CALENDAR_PROVIDER=fake
EMAIL_PROVIDER=fake
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=change-me

# Free tier is capped at ~20 requests/day PER MODEL, so transcripts and summaries use different models and each falls back on quota.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash
GEMINI_STT_MODEL=gemini-3.5-flash
GEMINI_STT_FALLBACK_MODELS=gemini-3.1-flash-lite

# Shared secret between the web app and the meeting bot
BOT_TOKEN=change-me-long-random
BOT_PROFILE_DIR=./.data/bot-profile
BOT_VNC_PASSWORD=choose-a-password
